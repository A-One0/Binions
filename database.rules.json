{
  "rules": {
    "pokerTables": {
      "$tableId": {
        "engine": {
          ".read": false,
          ".write": false
        },
        "public": {
          ".read": "auth != null",
          ".write": false
        },
        "holeCards": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      }
    },

    "plrAccounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
